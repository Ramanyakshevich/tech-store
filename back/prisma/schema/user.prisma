model User{
    id          String @id @default(cuid())

    email       String @unique
    password    String

    firstName   String
    lastName    String

    phoneNumber String @unique

    city        String?
    street      String?
    houseNumber String?
    zipCode     String?


    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("users")
}