model User{
    id          String @id @default(cuid())

    email       String @unique
    password    String

    firstName   String
    lastName    String

    phoneNumber String @unique

    city        String?
    street      String?
    houseNumber String?
    zipCode     String?

    tokens      Token[]

    orders      Order[]

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("users")
}

model Token{
    token       String @unique
    exp         DateTime

    user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId      String

    userAgent   String @default("unknown")

    @@map("tokens")
}