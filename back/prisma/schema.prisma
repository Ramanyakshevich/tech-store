generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique 
  description String
  price       Int      
  image       String 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}